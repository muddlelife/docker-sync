{% extends "base" %}{% block content %}
<div class="page-heading"><div><h1>镜像规则</h1><p class="muted">配置同步目标与架构，查看每个镜像的最新同步结果。</p></div><button id="new-rule" class="primary"><svg aria-hidden="true"><use href="/static/icons.svg#plus"/></svg>添加规则</button></div>
<div class="metrics compact"><div class="metric"><span>全部规则</span><strong id="rules-total">—</strong></div><div class="metric"><span>同步成功 / 内容一致</span><strong class="green" id="rules-success">—</strong></div><div class="metric"><span>进行中</span><strong class="blue" id="rules-active">—</strong></div><div class="metric"><span>失败 / 待核实</span><strong class="red" id="rules-failed">—</strong></div></div>
<section class="panel list-panel"><div class="panel-heading"><div class="heading-title"><h2>规则列表</h2><span class="muted" id="rules-count"></span></div><div class="actions"><button id="refresh-rules" aria-label="刷新规则状态"><svg aria-hidden="true"><use href="/static/icons.svg#refresh"/></svg>刷新</button><button id="sync-selected" class="primary">同步所选</button></div></div><div class="table-toolbar"><div class="search-field"><svg aria-hidden="true"><use href="/static/icons.svg#search"/></svg><input id="rule-search" type="search" placeholder="搜索规则名称、源镜像或目标镜像" aria-label="搜索镜像规则"></div><select id="rule-status-filter" aria-label="按同步状态筛选"><option value="all">全部同步状态</option><option value="success">同步成功 / 内容一致</option><option value="active">进行中</option><option value="failed">失败 / 待核实</option><option value="never">未同步</option></select></div><div id="rule-list" class="table-wrap"><p class="loading">正在读取规则…</p></div><div id="rules-pagination" class="pagination" aria-label="分页"></div></section>
<dialog class="panel editor" aria-modal="true" aria-labelledby="rule-editor-title" id="rule-editor" hidden><div class="panel-heading"><h2 id="rule-editor-title">添加镜像规则</h2><button data-close="rule-editor" type="button" class="link-button">关闭</button></div>
<form id="rule-form" class="panel-body"><div class="notice error" data-editor-notice role="alert" hidden></div><input type="hidden" name="id"><label for="rule-name">规则名称</label><input id="rule-name" name="name" placeholder="例如：Web 服务器" required maxlength="100"><label for="source">源镜像</label><input id="source" name="source" placeholder="nginx:latest 或 ghcr.io/组织/镜像:标签" required>
<div class="form-grid"><div><label for="registry-id">目标仓库</label><select id="registry-id" name="registry_id" required></select></div><div><label for="platform">同步架构</label><select id="platform" name="platform"><option value="all">全部架构（默认）</option><option value="linux/amd64">AMD64 · linux/amd64</option><option value="linux/arm64">ARM64 · linux/arm64</option></select></div></div>
<p class="help">全部架构保留源镜像的架构列表；单架构只复制所选平台，不转换架构。源镜像不支持时会报错。</p>
<div class="form-grid"><div><label for="target-repository">目标镜像名称</label><input id="target-repository" name="target_repository" placeholder="nginx" required></div><div><label for="target-tag">目标标签</label><input id="target-tag" name="target_tag" value="latest" required></div></div><div class="target-preview"><span>同步目标</span><code id="target-preview">请选择目标仓库</code></div>
<details><summary>私有源仓库凭据（可选）</summary><div class="form-grid"><div><label for="source-username">源仓库用户名</label><input id="source-username" name="source_username" autocomplete="off"></div><div><label for="source-password">源仓库密码</label><input id="source-password" name="source_password" type="password" autocomplete="new-password" placeholder="修改时留空保留"></div></div></details>
<label class="check"><input type="checkbox" name="enabled" checked>启用此规则</label><p class="help">修改架构后，下次同步会将目标标签替换为所选平台的内容。不同规则请使用独立目标标签。</p><div class="form-actions"><button type="submit" class="primary">保存规则</button></div></form></dialog>
{% endblock %}
