{% extends "base" %}{% block content %}
<div class="page-heading"><div><h1>同步任务</h1><p class="muted">查看每次同步的进度、结果和执行记录。</p></div><button id="refresh-tasks">刷新列表</button></div><section class="panel list-panel"><div id="task-list" class="table-wrap"><p class="loading">正在读取任务…</p></div><div id="tasks-pagination" class="pagination" aria-label="分页"></div></section>
{% endblock %}
