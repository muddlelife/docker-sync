{% extends "base" %}{% block content %}
<div class="login-shell"><section class="login-intro"><a class="login-brand" href="/login"><img src="/static/logo.svg" width="44" height="44" alt="Docker Sync"><span>Docker Sync</span></a><div class="login-copy"><span class="intro-label">镜像同步控制台</span><h1>你的镜像，<br>你的仓库。</h1><p>集中管理同步规则，<br>让镜像状态与多架构信息清晰可见。</p><div class="intro-tags"><span>多架构同步</span><span>远端镜像浏览</span><span>轻量部署</span></div></div><div class="login-orbit" aria-hidden="true"><div class="orbit-square"><svg><use href="/static/icons.svg#images"/></svg></div><span class="orbit-dot one"></span><span class="orbit-dot two"></span></div></section>
<section class="login-card"><h2>欢迎回来</h2><p class="muted">登录后管理你的镜像与同步任务。</p><form id="login-form"><label for="password">管理员密码</label><input id="password" name="password" type="password" placeholder="请输入管理员密码" autocomplete="current-password" required maxlength="1024" autofocus><button class="primary full" type="submit">登录控制台<svg aria-hidden="true"><use href="/static/icons.svg#arrow"/></svg></button></form><p class="help">管理员密码可通过服务的 show-setup 命令查看。</p></section></div><p class="login-footer">Docker Sync · 镜像同步控制台</p>
{% endblock %}
